# ASCEND environment variables.
# Copy to .env.local for local development. Never commit real values.
# The app works fully offline with no variables set.

# Sync (optional): another Supabase project instead of the built-in one (src/config/cloud.ts).
# Both are PUBLIC values, safe in the app — what a user may do is enforced by Row Level Security.
# If you change the URL, also add its origin to connect-src in vercel.json (Content-Security-Policy).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server secrets are NEVER app variables (anything starting with VITE_ ships inside the app).
# They are Supabase Edge Function secrets, set from PowerShell (see README, "Ask the System"):
#   npx supabase secrets set OPENROUTER_API_KEY=...   (required for Ask the System)
#   npx supabase secrets set OPENROUTER_MODEL=...     (optional model override)
# SUPABASE_SERVICE_ROLE_KEY is provided to the functions by Supabase itself — never copy it anywhere.
