# ASCEND environment variables.
# Copy to .env.local for local development. Never commit real values.
# The app works fully offline with no variables set.

# Phase 7 (sync) — public Supabase project values (safe in the client; protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 8 (AI coach) — NOT a client variable. Set it as a Supabase Edge Function secret:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
